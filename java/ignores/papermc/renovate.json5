{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  packageRules: [
    {
      matchManagers: [
        'maven',
        'maven-wrapper',
        'gradle',
        'gradle-wrapper'
      ],
      "matchPackageNames": [
        '/com\\.destroystokyo\\.paper:paper-api/',
        '/com\\.velocitypowered:velocity-api/',
        '/io\\.github\\.waterfallmc:waterfall-api/'
      ],
      "enabled": false
    }
  ]
}
