{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    'github>Siroshun09/renovate-config//base.renovate.json5',
    ':pinDevDependencies'
  ],
  "packageRules": [
    {
      groupName: 'all non-major dependencies for npm',
      groupSlug: 'npm-all-minor-patch',
      matchManagers: [
        'npm',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      matchPackageNames: [
        '*',
      ],
    }
  ]
}
